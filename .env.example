# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=

# ASR
ASR_PROVIDER=faster_whisper
OPENAI_STT_MODEL=
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# AI-Hub
AIHUB_API_KEY=
# AI-Hub shell examples may also use this lowercase name.
aihubapikey=
AIHUB_DATASET_KEY=
AIHUB_DOWNLOAD_DIR=./data/aihub

# Runtime
TEMP_AUDIO_DIR=./backend/temp_audio
DELETE_AUDIO_AFTER_TRANSCRIBE=true
